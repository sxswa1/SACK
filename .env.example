# Copy to .env in the repository root. SACK loads it automatically on import.
# Existing process environment variables take precedence over this file.

# Agent graph backend: graphdb or tugraph.
SACK_AGENT_GRAPH_BACKEND=tugraph
# This address assumes SACK runs on the same server as TuGraph.
SACK_TUGRAPH_BOLT_URL=bolt://127.0.0.1:7687
SACK_TUGRAPH_GRAPH=sack_kaggle_20261001
SACK_TUGRAPH_USER=admin
# Supply the existing account password; empty passwords are rejected.
SACK_TUGRAPH_PASSWORD=''

# PostgreSQL/pgvector remains required for case retrieval.
# Uncomment and fill in values for your deployment.
# SACK_PG_HOST=127.0.0.1
# SACK_PG_PORT=5432
# SACK_PG_USER=sack_knowledge_reader
# SACK_PG_PASSWORD_FILE=/absolute/path/to/postgresql-password

# Model API credentials continue to use sack/api_key.txt (four-line format).
